# ANTHROPIC_API_KEY: Required for Claude API calls (https://console.anthropic.com/settings/keys).
# Set this in the Secrets panel / .env; never commit the real key.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# ANTHROPIC_MODEL: Optional model override (default: claude-sonnet-4-5).
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
